# JARVIS Environment Variables

# AI / LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Database Settings
DATABASE_URL=sqlite:///data/jarvis.db

# Voice Settings
WAKE_WORD=jarvis
TTS_RATE=150
TTS_VOLUME=1.0

# Integration Credentials
VTOP_USERNAME=your_vtop_username
VTOP_PASSWORD=your_vtop_password

# Log Level
LOG_LEVEL=INFO
